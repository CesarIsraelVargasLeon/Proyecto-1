casos_por_año <- datos %>%
filter(PROSTCAN_A == 1 & !is.na(PROSTCAN_A)) %>% # Aseguramos filtrar solo casos y quitamos NAs si los hubiera
group_by(Año) %>%
summarise(Numero_Casos = n()) %>% # n() cuenta las filas en cada grupo
ungroup() # Desagrupamos para el gráfico
# --- Creación del Gráfico de Barras ---
ggplot(casos_por_año, aes(x = factor(Año), y = Numero_Casos)) +
geom_bar(stat = "identity", fill = "coral") + # stat="identity" usa los valores de Y directamente
geom_text(aes(label = Numero_Casos), vjust = -0.5, size = 3.5) + # Añade el número encima de cada barra
labs(
title = "Número de Casos Positivos de Cáncer de Próstata por Año",
subtitle = "Datos NHIS (2018-2024), Hombres > 40 años",
x = "Año de la Encuesta",
y = "Número de Casos Reportados"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
casos_positivos <- datos[datos$PROSTCAN_A == 1 & !is.na(datos$PROSTCAN_A), ]
# 2. Contamos los casos por año usando table()
casos_por_año <- table(casos_positivos$Año)
# --- Creación del Gráfico de Barras con R Base ---
# Guardamos las coordenadas x de las barras para poder poner texto encima
bar_coords <- barplot(
casos_por_año,
main = "Número de Casos Positivos de Cáncer de Próstata por Año",
xlab = "Año de la Encuesta",
ylab = "Número de Casos Reportados",
ylim = c(0, max(casos_por_año) * 1.1), # Ajusta el límite Y para dar espacio al texto
col = "coral",
las = 2 # Rota las etiquetas del eje X si son muchas
)
table(casos_positivos$Año)
