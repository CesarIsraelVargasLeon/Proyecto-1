predicciones_hbp <- ggpredict(modelo_interacciones_completo, terms = c("SMKCIGST_A", "DIBEV_A"))
predicciones_hbp <- ggpredict(m_inter, terms = c("SMKCIGST_A", "DIBEV_A"))
grafico_hbp <- ggplot(predicciones_hbp, aes(x = x, y = predicted, color = group)) +
geom_point(position = position_dodge(width = 0.3), size = 3) +
geom_errorbar(aes(ymin = conf.low, ymax = conf.high),
position = position_dodge(width = 0.3), width = 0.2) +
labs(
title = "Interacción: Tabaquismo y Diabetes",
y = "Probabilidad Predicha de Cáncer",
x = "Estatus de Tabaquismo",
color = "Diabetes"
) +
theme_minimal()
plot(grafico_hbp)
predicciones_finales <- ggpredict(modelo_interacciones_completo,
terms = c("SMKCIGST_A", "DIBEV_A"))
predicciones_finales <- ggpredict(m_inter,
terms = c("SMKCIGST_A", "DIBEV_A"))
grafico_final <- ggplot(predicciones_finales, aes(x = x, y = predicted, color = group, group = group)) +
geom_line(linewidth = 1) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = conf.low, ymax = conf.high),
width = 0.2, alpha = 0.5) +
labs(
title = "Efecto Sinérgico: Tabaquismo y Diabetes",
subtitle = "Probabilidad Predicha de Cáncer de Próstata (Ajustado por Edad, Raza, IMC e Hipertensión)",
x = "Estatus de Tabaquismo",
y = "Probabilidad de Cáncer (%)",
color = "¿Tiene Diabetes?"
) +
scale_y_continuous(labels = scales::percent) +
scale_color_manual(values = c("No" = "#1f77b4", "Sí" = "#d62728")) +
theme_minimal() +
theme(
legend.position = "bottom",
plot.title = element_text(face = "bold", size = 14),
axis.text.x = element_text(angle = 0)
)
plot(grafico_final)
