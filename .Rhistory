casos_por_año,
main = "Número de Casos Positivos de Cáncer de Próstata por Año",
xlab = "Año de la Encuesta",
ylab = "Número de Casos Reportados",
ylim = c(0, max(casos_por_año) * 1.1), # Ajusta el límite Y para dar espacio al texto
col = "coral",
las = 2 # Rota las etiquetas del eje X si son muchas
)
